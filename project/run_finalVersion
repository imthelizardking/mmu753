fprintf('Open-Loop: %.4f\n', rms(y_ab_ol));
fprintf('K_lower:       %.4f\n',   rms(y_ab_hinf_lower));
fprintf('K_higher:      %.4f\n',   rms(y_ab_hinf_higher));
fprintf('K_lpv:         %.4f\n\n', rms(y_ab_hinf_lpv));

disp('--- Tire Deflection RMS [cm] ---');
