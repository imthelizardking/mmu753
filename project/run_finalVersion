plot(t_, y_td_hinf_higher*100, 'g',  'LineWidth',1.0);
plot(t_, y_td_hinf_lpv*100,'k',  'LineWidth',1.0);
title('Tire Deflection (Road Holding)');
ylabel('cm'); xlabel('Time (s)'); grid on;
legend(sprintf('OL (%.4f)',   rms(y_td_ol)*100), ...
